# 1 = fixtures only (no keys, no network). Set 0 for a live run.
OFFLINE=1
# 1 = write .eml files to outbox/ instead of sending. Set 0 to send via Gmail.
DRY_RUN=1

# LLM: gemini (free tier) or anthropic
LLM_PROVIDER=gemini
# Up to three free-tier keys, rotated when one runs out of quota.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Step 4: Hunter.io Domain Search (free: 25 searches/month). Empty = use data/contacts.csv
HUNTER_API_KEY=

# Step 7: Gmail. Create an app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Case rule: every email goes to your own inbox
TO_ADDRESS=you@example.com
SENDER_NAME=Ravi
